@model List<Class>

<style>
    body {
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8)
    }
</style>
<table class="table table-striped">

    <tr>
        <th>Id</th>
        <th>Material</th>
        <th>DrName</th>
        <th>Add</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Material</td>
            <td>@item.DrName</td>
            <td>
                <a asp-action="AddToMySchedule" asp-route-id="@item.Id" class="btn btn-primary">Add</a>
            </td>
        </tr>
    }

</table>
