@model List<Class>

<style>
    body {
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8)
    }
</style>

    <table class="table table-striped">

        <tr>
            <th>Id</th>
        <th>Material</th>
            <th>DrName</th>
            <th>detial</th>
            <th>Action</th>
        </tr>
        @foreach(var x in Model)
    {
        <tr>
            <td>@x.Id</td>
            <td>@x.Material</td>
            <td>@x.DrName</td>
            <td><a asp-action="Detial" class="btn btn-primary" asp-route-Id="@x.Id">Info</a></td>
            <td><a asp-action="Delete" class="btn btn-danger" asp-route-Id="@x.Id">Delete</a>
                <a asp-action="Edit" class="btn btn-secondary" asp-route-Id="@x.Id">Edit</a></td>
        </tr>
    }
</table>
<a asp-action="Add" class="btn btn-primary">Add </a>