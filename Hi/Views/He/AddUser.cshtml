@model List<Class>

    <table class="table table-striped">

        <tr>
            <th>Id</th>
            <th>Material</th>
            <th>DrName</th>
            <th>Delete</th>
        </tr>
        @foreach(var x in Model)
    {
        <tr>
            <td>@x.Id</td>
            <td>@x.Material</td>
            <td>@x.DrName</td>
            <td><a asp-action="Delete" class="btn btn-danger" asp-route-Id="@x.Id">Delete</a></td>
        </tr>
    }
    </table>
