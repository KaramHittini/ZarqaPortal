@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Privacy Policy</h2>
        </div>
        <div class="card-body">
            <p class="lead">Your privacy is important to us at Zarqa University.</p>
            
            <h4>Information We Collect</h4>
            <p>We collect information necessary to provide educational services, including:</p>
            <ul>
                <li>Student identification information</li>
                <li>Academic records and grades</li>
                <li>Course registration data</li>
            </ul>

            <h4>How We Use Your Information</h4>
            <p>Your information is used solely for educational purposes and to improve our services.</p>

            <h4>Contact Us</h4>
            <p>If you have any questions about our privacy practices, please contact the IT department.</p>
        </div>
    </div>
</div>
