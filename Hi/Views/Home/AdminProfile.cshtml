@{
    ViewData["Title"] = "Admin Profile";
}

<style>
    body {
        background: linear-gradient(to bottom, #000000, #1e3c72, #6fb1e8);
        min-height: 100vh;
    }

    .admin-container {
        max-width: 600px;
        margin: 50px auto;
    }

    .admin-card {
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .admin-header {
        background: linear-gradient(135deg, #dc3545, #c82333);
        padding: 30px;
    }

    .admin-avatar {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 2.5rem;
    }

    .feature-item {
        transition: background-color 0.2s;
    }

    .feature-item:hover {
        background-color: #f8f9fa;
    }

    .feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }
</style>

<div class="container">
    <div class="admin-container">
        <div class="card admin-card">
            <div class="admin-header text-white text-center">
                <div class="admin-avatar">
                    <i class="bi bi-shield-lock-fill text-white"></i>
                </div>
                <h3 class="mb-1">Admin</h3>
                <p class="mb-0 opacity-75">System Administrator</p>
                <span class="badge bg-warning text-dark mt-2">Professor Access</span>
            </div>
            <div class="card-body p-0">
                <div class="p-3 bg-light border-bottom">
                    <h6 class="mb-0 text-muted">
                        <i class="bi bi-gear me-2"></i>Available Features
                    </h6>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item feature-item d-flex align-items-center py-3">
                        <div class="feature-icon bg-success text-white me-3">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <div>
                            <strong>Add Courses</strong>
                            <br />
                            <small class="text-muted">Create new courses for students</small>
                        </div>
                    </li>
                    <li class="list-group-item feature-item d-flex align-items-center py-3">
                        <div class="feature-icon bg-primary text-white me-3">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <strong>Edit Courses</strong>
                            <br />
                            <small class="text-muted">Modify course details and information</small>
                        </div>
                    </li>
                    <li class="list-group-item feature-item d-flex align-items-center py-3">
                        <div class="feature-icon bg-danger text-white me-3">
                            <i class="bi bi-trash"></i>
                        </div>
                        <div>
                            <strong>Delete Courses</strong>
                            <br />
                            <small class="text-muted">Remove courses from the system</small>
                        </div>
                    </li>
                    <li class="list-group-item feature-item d-flex align-items-center py-3">
                        <div class="feature-icon bg-info text-white me-3">
                            <i class="bi bi-eye"></i>
                        </div>
                        <div>
                            <strong>View All Courses</strong>
                            <br />
                            <small class="text-muted">Browse the complete course catalog</small>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-light p-3">
                <div class="d-grid gap-2">
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-book me-2"></i>Manage Courses
                    </a>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Auth" asp-action="Logout" class="text-white text-decoration-none">
                <i class="bi bi-box-arrow-left me-1"></i>Logout
            </a>
        </div>
    </div>
</div>
