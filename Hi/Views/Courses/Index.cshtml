@model IEnumerable<ZarqaPortal.Web.Core.Entities.Course>

@{
    ViewData["Title"] = "Courses";
}

<style>
    body {
        background: linear-gradient(to bottom, #000000, #1e3c72, #6fb1e8)
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">Course Catalog</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Course
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Course Name</th>
                        <th>Instructor</th>
                        <th>Credit Hours</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.Id</td>
                            <td>@course.Name</td>
                            <td>@course.InstructorName</td>
                            <td>@course.CreditHours</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-info">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-secondary">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
