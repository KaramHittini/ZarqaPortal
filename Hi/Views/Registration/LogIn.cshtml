@model Login

<style>
    body{
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8)
    }
    .login-container {
        max-width: 400px; /* لتصغير العرض */
        margin: 50px auto; /* للتوسيط في منتصف الصفحة */
        background: linear-gradient( to bottom, #9fd3f2, #1e4fa1, #000000 );
        box-shadow: 0 4px 8px rgba(0,0,0,0.1); /* ظل خفيف لإبراز المربع */
        
        padding: 30px;
        border-radius: 20px;
    }
</style>

<h1 style="text-align:center;color:white;">Zarqa Portal</h1>
<div class="login-container">
    <form asp-action="LogIn">
        <div asp-validation-summary="ModelOnly" class="text-bg-danger"></div>
        
        <div class="form-group mb-3"> <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter Username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input type="password" asp-for="Password" class="form-control" placeholder="Enter password" id="passInput"/>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="text-center mt-4">
            <input type="submit" value="Log In" class="btn btn-light w-100" /> </div>
    </form>
</div>