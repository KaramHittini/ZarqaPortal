@model ZarqaPortal.Web.Core.Entities.Course

@{
    ViewData["Title"] = "Create Course";
}

<style>
    body {
        background: linear-gradient(to bottom, #000000, #1e3c72, #6fb1e8)
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Create New Course</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input type="text" asp-for="Name" class="form-control" placeholder="Enter course name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter course description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstructorName" class="form-label"></label>
                            <input type="text" asp-for="InstructorName" class="form-control" placeholder="Enter instructor name" />
                            <span asp-validation-for="InstructorName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CreditHours" class="form-label"></label>
                            <input type="number" asp-for="CreditHours" class="form-control" min="1" max="6" />
                            <span asp-validation-for="CreditHours" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">Create Course</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
