@model ZarqaPortal.Web.Shared.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Error</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger">An error occurred while processing your request.</h5>

                    @if (Model?.ShowRequestId ?? false)
                    {
                        <p class="mt-3">
                            <strong>Request ID:</strong> <code>@Model?.RequestId</code>
                        </p>
                    }

                    <hr />
                    <h6>What you can do:</h6>
                    <ul>
                        <li>Try refreshing the page</li>
                        <li>Go back to the <a asp-controller="Home" asp-action="Index">home page</a></li>
                        <li>Contact support if the problem persists</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
