@model ZarqaPortal.Web.Core.Entities.StudentProfile

@{
    ViewData["Title"] = "My Profile";
}

<style>
    body {
        background: linear-gradient(to bottom, #000000, #1e3c72, #6fb1e8)
    }

    .profile-container {
        max-width: 500px;
        margin: 50px auto;
    }
</style>

<div class="container">
    <div class="profile-container">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">Student Profile</h4>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <img src="https://via.placeholder.com/100" class="rounded-circle" alt="Profile Photo" />
                </div>
                <h5 class="card-title">@Model.FullName</h5>
                <p class="text-muted">@Model.Major</p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span><strong>Student ID:</strong></span>
                    <span>@Model.StudentId</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span><strong>College:</strong></span>
                    <span>@Model.College</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span><strong>GPA:</strong></span>
                    <span class="badge bg-success">@Model.Gpa.ToString("F2")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span><strong>Completed Hours:</strong></span>
                    <span>@Model.CompletedHours</span>
                </li>
            </ul>
            <div class="card-footer text-center">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                    View Available Courses
                </a>
            </div>
        </div>
    </div>
</div>
