@model IEnumerable<ZarqaPortal.Web.Core.Entities.StudentSchedule>

@{
    ViewData["Title"] = "My Schedule";
}

<style>
    body {
        background: linear-gradient(to bottom, #000000, #1e3c72, #6fb1e8);
        min-height: 100vh;
    }

    .schedule-header {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .schedule-card {
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    .empty-schedule {
        padding: 60px 20px;
        text-align: center;
        color: #6c757d;
    }

    .empty-schedule i {
        font-size: 4rem;
        margin-bottom: 20px;
    }
</style>

<div class="container mt-4">
    <div class="schedule-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="text-white mb-1">
                <i class="bi bi-calendar3 me-2"></i>My Schedule
            </h1>
            <p class="text-white-50 mb-0">Courses enrolled by @ViewBag.StudentName</p>
        </div>
        <div>
            <a asp-controller="StudentProfile" asp-action="Index" class="btn btn-light">
                <i class="bi bi-arrow-left me-1"></i>Back to Profile
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card schedule-card">
        <div class="card-body">
            @if (Model.Any())
            {
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Course Name</th>
                            <th>Instructor</th>
                            <th>Credit Hours</th>
                            <th>Added On</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Course?.Name</strong>
                                    @if (!string.IsNullOrEmpty(item.Course?.Description))
                                    {
                                        <br />
                                        <small class="text-muted">@item.Course.Description</small>
                                    }
                                </td>
                                <td>@item.Course?.InstructorName</td>
                                <td>
                                    <span class="badge bg-primary">@item.Course?.CreditHours hrs</span>
                                </td>
                                <td>@item.AddedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-action="RemoveCourse" method="post" style="display:inline;">
                                        <input type="hidden" name="courseId" value="@item.CourseId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Remove this course from your schedule?')">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3 p-3 bg-light rounded">
                    <div class="row text-center">
                        <div class="col">
                            <h5 class="mb-0">@Model.Count()</h5>
                            <small class="text-muted">Total Courses</small>
                        </div>
                        <div class="col">
                            <h5 class="mb-0">@Model.Sum(s => s.Course?.CreditHours ?? 0)</h5>
                            <small class="text-muted">Total Credit Hours</small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-schedule">
                    <i class="bi bi-calendar-x text-muted"></i>
                    <h4>No Courses Yet</h4>
                    <p class="text-muted">You haven't added any courses to your schedule.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Browse Courses
                    </a>
                </div>
            }
        </div>
    </div>
</div>
