@model Class
<style>
    body {
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8)
    }
</style>
<form asp-action="Add">
    <div class="for-group">
        <label asp-for="Material" style="color:white">Material</label>
        <input type="text" asp-for="Material" class="form-control" />
        <span asp-validation-for="Material" class="text-danger"></span>
    </div>
    <div class="for-group">
        <label asp-for="DrName" style="color:white">Dr , the Owner of the subject</label>
        <input type="text" asp-for="DrName" class="form-control" />
        <span asp-validation-for="DrName" class="text-danger"></span>
    </div>

    <br />
    <input type="submit" class="btn btn-primary" class="form-control" value="Add"/>
    
</form>