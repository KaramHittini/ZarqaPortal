@model Hi.Models.profile

<style>
    body {
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8)
    }

    .login-container {
        max-width: 400px; /* لتصغير العرض */
        margin: 50px auto; /* للتوسيط في منتصف الصفحة */
        background: linear-gradient( to bottom, #000000, #1e3c72, #6fb1e8) ; color: white;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1); /* ظل خفيف لإبراز المربع */

        padding: 30px;
        border-radius: 20px;
        text-align:center;
    }
</style>

<div class="card">
    <div class="card-body">
        <h5 class="card-title" style="text-align:center;">@Model.Name</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">Major: @Model.Major</li>
            <li class="list-group-item">GPA: @Model.GPA</li>
            <li class="list-group-item">ID: @Model.StudentID</li>
            <li class="list-group-item">Hours: @Model.CompletedHours</li>
            <li class="list-group-item">Advisor: Dr. Who</li>
        </ul>
    </div>
</div>
<div class="text-center mt-3">
<a asp-action="UserTable" class="btn btn-primary" >Class Registration</a>
</div>