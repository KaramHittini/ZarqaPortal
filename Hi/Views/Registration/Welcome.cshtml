@model Login

@{
    ViewBag.Title = "Educational Portal";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Educational Portal</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            height: 100vh;
            background: linear-gradient(to bottom, #bfe6f2, #3f7fd9, #000);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 90%;
            height: 80%;
            display: flex;
            gap: 40px;
        }

        /* Left Panel */
        .left-panel {
            flex: 1;
            padding: 40px;
            border-radius: 40px;
            background: linear-gradient(to bottom, #8fc6ff, #1f4fa8, #000);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .left-panel small {
                letter-spacing: 2px;
                opacity: 0.8;
            }

            .left-panel h1 {
                font-size: 50px;
                line-height: 1.2;
            }

        .login-btn {
            width: 120px;
            padding: 10px;
            border: none;
            border-radius: 10px;
            background: #2f6cff;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        /* Right Panel */
        .right-panel {
            flex: 1;
            border-radius: 40px;
            overflow: hidden;
        }

            .right-panel img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
    </style>
</head>

<body>

    <div class="container">

        <!-- Left Side -->
        <div class="left-panel">
            <small>ZARQA UNIVERSITY</small>

            <h1>
                Your<br />
                Educational<br />
                Portal
            </h1>

            <a asp-action="LogIn" class="login-btn">LogIn</a>
            
        </div>

    </div>

</body>
</html>
