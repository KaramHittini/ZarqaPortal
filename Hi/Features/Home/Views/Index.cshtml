@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Zarqa Portal</h1>
    <p class="lead">Your gateway to university resources and course management.</p>
    <hr class="my-4" />
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Browse and manage available courses.</p>
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">View Courses</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text">View your academic profile and progress.</p>
                    <a asp-controller="StudentProfile" asp-action="Index" class="btn btn-primary">View Profile</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Contact</h5>
                    <p class="card-text">Get in touch with the administration.</p>
                    <a href="#" class="btn btn-secondary">Contact Us</a>
                </div>
            </div>
        </div>
    </div>
</div>
